<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>Api</AssemblyName>
    <RootNamespace>Api</RootNamespace>
  </PropertyGroup>

  <!-- The host references the building blocks and each module it wants to compose.
       Adding a module = add its ProjectReference here and one entry in AddModules(...). -->
  <ItemGroup>
    <ProjectReference Include="../Shared/BuildingBlocks/BuildingBlocks.csproj" />
    <ProjectReference Include="../Modules/Identity/Identity.csproj" />
    <ProjectReference Include="../Modules/Clients/Clients.csproj" />
    <ProjectReference Include="../Modules/Expenses/Expenses.csproj" />
    <ProjectReference Include="../Modules/Todos/Todos.csproj" />
    <ProjectReference Include="../Modules/DashboardCharts/DashboardCharts.csproj" />
    <ProjectReference Include="../Modules/Revenues/Revenues.csproj" />
    <ProjectReference Include="../Modules/Reports/Reports.csproj" />
    <ProjectReference Include="../Modules/Cars/Cars.csproj" />
    <ProjectReference Include="../Modules/Workers/Workers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- On `dotnet publish`, build the Angular SPA and drop it into wwwroot so the API
       serves it. Single process, no extra tooling at runtime. -->
  <PropertyGroup>
    <SpaRoot>..\..\web\</SpaRoot>
  </PropertyGroup>

  <Target Name="PublishSpa" BeforeTargets="ComputeFilesToPublish">
    <Exec Command="npm install" WorkingDirectory="$(SpaRoot)" Condition="!Exists('$(SpaRoot)node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(SpaRoot)" />
    <ItemGroup>
      <DistFiles Include="$(SpaRoot)dist\web\browser\**\*" />
      <ResolvedFileToPublish Include="@(DistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
